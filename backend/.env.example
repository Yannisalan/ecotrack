# Copy this file to the PROJECT ROOT as `.env` (../.env). The app loads it
# whether you start the backend from the repo root or from backend/.

# --- Database -----------------------------------------------------------------
# Option A (Neon / any hosted Postgres): paste the full connection string.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&channel_binding=require

# Option B (local Postgres): leave DATABASE_URL out and use these instead.
# DB_USER=postgres
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=ecotrack

# --- Secrets ------------------------------------------------------------------
# Required. The app refuses to start without it (there is no default) and also
# refuses to start if it is shorter than 32 characters. Generate:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=

# --- CORS ---------------------------------------------------------------------
# Comma-separated allowed browser origins. Exact origins only - wildcards
# (including a bare "*") are dropped, because a wildcard allowlist lets any
# site drive the API with the user's cookies. Leave this empty (the default)
# when the web app and the API share one origin, which is the recommended
# deployment. For local web development list the exact port Flutter prints,
# e.g. http://localhost:53187,http://127.0.0.1:53187
CORS_ORIGINS=

# --- Runtime ------------------------------------------------------------------
FLASK_DEBUG=1
PORT=5000
# The refresh cookie is marked Secure by default, so browsers only send it
# over HTTPS. Set to "false" only for local http development (the app also
# turns it off automatically when FLASK_DEBUG=1).
JWT_COOKIE_SECURE=false

# --- Optional features --------------------------------------------------------
# Per-IP (or per-user) rate limiting (default true).
RATELIMIT_ENABLED=true
# Default limit applied to every route without its own limit.
RATELIMIT_DEFAULT=600 per minute
# Where the rate limiter keeps its counters. "memory://" is per-process and
# resets on restart; use a shared backend (for example
# "redis://HOST:PORT/0") when you run more than one worker.
RATELIMIT_STORAGE_URI=memory://
# Number of trusted reverse proxies in front of the app (1 on Render). Set 0
# when running directly so X-Forwarded-For cannot be spoofed.
PROXY_FIX_HOPS=1
# Maximum request body size in bytes (default 1 MB).
MAX_CONTENT_LENGTH=1048576
# Reset tokens are NOT returned in the API response unless this is true. There
# is no SMTP integration, so leave false except for a throwaway demo.
RESET_TOKEN_IN_RESPONSE=false
# Master switch for the in-process APScheduler (daily token purge + optional
# reminders). Keep false unless you run a SINGLE worker, e.g.
# `gunicorn run:app --workers 1`, otherwise every worker starts its own
# scheduler and jobs run once per worker.
ENABLE_SCHEDULER=false
# Hourly background job that materializes reminders for every user.
# Requires ENABLE_SCHEDULER=true.
REMINDER_SCHEDULER=false

# --- SECURITY ---------------------------------------------------------------
# Never commit a real .env. If a secret was ever committed or shared, rotate
# it: generate a new JWT_SECRET_KEY above and change the database password in
# the Neon console. Deleting the file does NOT invalidate leaked values.
